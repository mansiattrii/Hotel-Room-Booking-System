# Copy to .env and replace the dummy values. .env is gitignored.

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=hotel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hotel_booking
POSTGRES_HOST_PORT=5434

# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://hotel:change-me@127.0.0.1:5434/hotel_booking
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=5

# Auth
JWT_SECRET=replace-with-output-of-python-secrets-token-urlsafe-48
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bookings (BOOKING_STRATEGY: constraint | pessimistic | naive; naive is for experiments only)
BOOKING_STRATEGY=constraint
HOLD_MINUTES=10
MAX_STAY_NIGHTS=30
BOOKING_HORIZON_DAYS=365
WORKER_INTERVAL_SECONDS=30

# Tests run against a separate database in the same container
TEST_DATABASE_URL=postgresql+psycopg://hotel:change-me@127.0.0.1:5434/hotel_booking_test
